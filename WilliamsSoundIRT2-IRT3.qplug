  Controls["Connect"].EventHandler = function(ctl)
    Connect()
  end
  
  Controls["Audio Data Reset"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- Audio Data Reset Command - Reset CHA & CHB audio capture data
      Timer.CallAfter(function() serial:Write("audio_minmax_reset\r\n") end, .5)
      -- Get ChA Audio Data Command - min and max of CHA audio since reset
      Timer.CallAfter(function() serial:Write("audio_minmax_cha\r\n") end, .6)
      -- Get ChB Audio Data Command - min and max of CHB audio since reset
      Timer.CallAfter(function() serial:Write("audio_minmax_chb\r\n") end, .7)
      -- Return to Monitoring Mode
      Timer.CallAfter(function() serial:Write("}") end, 2)
    end
  end

  Controls["Sleep"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- Sleep Command
      Timer.CallAfter(function() serial:Write("sleep_now\r\n") end, .5)
      -- Return to Monitoring Mode
      Timer.CallAfter(function() serial:Write("}") end, 2)
    end
  end

  Controls["Wake"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- Wake Command
      Timer.CallAfter(function() serial:Write("wake_now\r\n") end, .5)
      -- Return to Monitoring Mode
      Timer.CallAfter(function() serial:Write("}") end, 2)
    end
  end

  Controls["Audio Input Mute"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- Mute Audio Input Command
      Timer.CallAfter(function() serial:Write("mute_audio_input=on\r\n") end, .5)
      -- Return to Monitoring Mode
      Timer.CallAfter(function() serial:Write("}") end, 2)
    end
  end

  Controls["Audio Input Unmute"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- Unmute Audio Input Command
      Timer.CallAfter(function() serial:Write("mute_audio_input=off\r\n") end, .5)
      -- Return to Monitoring Mode
      Timer.CallAfter(function() serial:Write("}") end, 2)
    end
  end

  Controls["IR Power - Full"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- IR Full Power Mode Command
      Timer.CallAfter(function() serial:Write("ir_low_power_mode=0\r\n") end, .5)
      -- Return to Monitoring Mode
      Timer.CallAfter(function() serial:Write("}") end, 2)
    end
  end
  
  Controls["IR Power - Half"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- IR Low Power Mode Command
      Timer.CallAfter(function() serial:Write("ir_low_power_mode=1\r\n") end, .5)
      -- Return to Monitoring Mode
      Timer.CallAfter(function() serial:Write("}") end, 2)
    end
  end

  Controls["RF Band 2.3/2.8MHz"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- Select RF Band 2.3/2.8MHz Command
      Timer.CallAfter(function() serial:Write("rf_band_select=0\r\n") end, .5)
      -- Return to Monitoring Mode
      Timer.CallAfter(function() serial:Write("}") end, 2)
    end
  end 

  Controls["RF Band 3.3/3.8MHz"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- Select RF Band 3.3/3.8MHz Command
      Timer.CallAfter(function() serial:Write("rf_band_select=1\r\n") end, .5)
      -- Return to Monitoring Mode
      Timer.CallAfter(function() serial:Write("}") end, 2)
    end
  end

  Controls["Restore Defaults"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- Restore Defaults Command - device will also Reboot
      Timer.CallAfter(function() serial:Write("restore_defaults\r\n") end, .5)
    end
  end 

  Controls["Reboot"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- Reboot Device
      Timer.CallAfter(function() serial:Write("reboot_unit\r\n") end, .5)
    end
  end

  Controls["LEDs Enable"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- LEDs Enable Command
      Timer.CallAfter(function() serial:Write("visible_leds=enable\r\n") end, .5)
      -- Return to Monitoring Mode
      Timer.CallAfter(function() serial:Write("}") end, 2)
    end
  end  
  
  Controls["LEDs Disable"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- LEDs Disable Command
      Timer.CallAfter(function() serial:Write("visible_leds=disable\r\n") end, .5)
      -- Return to Monitoring Mode
      Timer.CallAfter(function() serial:Write("}") end, 2)
    end
  end

  Controls["LEDs Blink"].EventHandler = function()
    if serial.IsOpen then
      -- Set Command Mode
      serial:Write("{")
      -- LEDs Blink for 5 Seconds Command
      Timer.CallAfter(function() serial:Write("visible_leds=blink_5sec\r\n") end, .5)
      -- Return to Monitoring Mode
      Timer.CallAfter(function() serial:Write("}") end, 2)
    end
  end

  Initialize()

end, 5)

